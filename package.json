{
  "name": "dots2",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:agent-server": "node server/agent-runtime.mjs",
    "docs:sync": "prettier --write \"docs/**/*.md\"",
    "report:deepseek": "node server/reporting/roll-deepseek-reports.mjs",
    "train:atman": "node server/dialog/train-atman.mjs",
    "training:prepare": "node server/training/training-prepare.mjs",
    "training:start": "node server/training/training-start.mjs",
    "training:evaluate": "node server/training/training-evaluate.mjs",
    "training:activate": "node server/training/training-activate.mjs",
    "preflight:agent-server": "node server/self_learning/preflight.mjs",
    "smoke:agent-server": "node server/self_learning/smoke-test.mjs",
    "beta:test": "node server/testing/beta-test-runner.mjs",
    "beta:scenarios": "node server/testing/personality-scenario-runner.mjs",
    "beta:admin": "node server/testing/admin-ui-beta.mjs",
    "beta:load": "node server/testing/load-test.mjs",
    "beta:chaos": "node server/testing/chaos-test.mjs",
    "beta:soak": "node server/testing/soak-test.mjs",
    "beta:report": "node server/testing/generate-test-report.mjs",
    "coverage:runtime": "node server/testing/runtime-coverage-runner.mjs",
    "quality:test": "node server/testing/quality-toolchain-check.mjs",
    "quality:coverage": "c8 --check-coverage --lines 65 --functions 75 --branches 70 --statements 65 --reporter=text-summary --reporter=json-summary node server/testing/quality-toolchain-check.mjs",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:deps": "depcruise --config .dependency-cruiser.cjs server src static --output-type err",
    "audit:ci": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm run format:check && npm run build",
    "verify:quality": "npm run check && npm run check:deps && npm run audit:ci && npm run quality:test",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@openai/agents": "^0.0.10",
    "playwright": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^19.2.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "c8": "^11.0.0",
    "dependency-cruiser": "^17.4.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vite": "^6.4.2"
  }
}
